# ====================================================================
# Variáveis de Ambiente - Dungeon and Soccer
# --------------------------------------------------------------------
# Copie este arquivo para `.env` (desenvolvimento) ou configure as
# mesmas variáveis no painel da Vercel (produção).
# ====================================================================

# ---- Database ----
# LOCAL DEV (sandbox/testes): SQLite — o schema detecta automaticamente.
# PROD (Vercel+Neon): troque para "postgresql" em prisma/schema.prisma
# e use a connection string do Neon abaixo.
#
# SQLite (dev):
DATABASE_URL="file:/home/z/my-project/db/custom.db"
#
# PostgreSQL (Neon, produção):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=300"

# ---- Painel Administrativo (login/senha) ----
# OBRIGATÓRIO em produção. Em dev, defaults "admin/admin123" são usados.
# Em produção, a aplicação recusa iniciar se ADMIN_PASSWORD for o default
# ou tiver menos de 8 caracteres.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Segredo HMAC para assinar cookies (gere com: openssl rand -hex 32)
# OBRIGATÓRIO em produção (mínimo 16 caracteres). Em dev, há fallback.
JWT_SECRET="gere-uma-string-aleatoria-de-64-caracteres-aqui"

# ---- Cron / Limpeza de contas inativas ----
# Token secreto para autorizar o cron /api/cron/cleanup-inactive.
# O Vercel Scheduler envia este token no header Authorization: Bearer ${CRON_SECRET}.
# Gere com: openssl rand -hex 32
CRON_SECRET="gere-outra-string-aleatoria-de-64-caracteres-aqui"

# ---- API externa de jogadores ----
# TheSportsDB (free tier, key "3" = public test key)
THESPORTSDB_API_KEY="3"

# API-Football (https://www.api-football.com/) — ampla cobertura com fotos
# Free tier: 10 requests/day. Pro: $9.99/mês (3000 req/dia)
# Cadastre-se em https://dashboard.api-football.com/register
API_FOOTBALL_KEY=""

# ---- Aplicação ----
NEXT_PUBLIC_APP_NAME="Dungeon and Soccer"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

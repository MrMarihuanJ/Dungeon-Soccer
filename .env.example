# ====================================================================
# Variáveis de Ambiente - Dungeon and Soccer
# --------------------------------------------------------------------
# Copie este arquivo para `.env` (desenvolvimento) ou configure as
# mesmas variáveis no painel da Vercel (produção).
# ====================================================================

# ---- Database (PostgreSQL obrigatório - usamos Neon) ----
# LOCAL: crie um branch "dev" no Neon ou rode Postgres localmente
# PROD:  use a connection string principal do Neon
#
# Formato: postgresql://USER:PASSWORD@ep-XXXX.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=300
#
# ⚠️ NÃO use SQLite (file:./dev.db) — o schema agora exige PostgreSQL!
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=300"

# ---- Painel Administrativo (login/senha) ----
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Segredo HMAC para assinar cookies (gere com: openssl rand -hex 32)
JWT_SECRET="gere-uma-string-aleatoria-de-64-caracteres-aqui"

# ---- API externa de jogadores ----
# TheSportsDB (free tier, key "3" = public test key)
THESPORTSDB_API_KEY="3"

# API-Football (https://www.api-football.com/) — ampla cobertura com fotos
# Free tier: 10 requests/day. Pro: $9.99/mês (3000 req/dia)
# Cadastre-se em https://dashboard.api-football.com/register
API_FOOTBALL_KEY=""

# ---- Aplicação ----
NEXT_PUBLIC_APP_NAME="Dungeon and Soccer"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
